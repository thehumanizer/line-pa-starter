    "logs": "wrangler tail",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.130.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
