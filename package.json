{
  "name": "line-pa-starter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "PA ของเราในไลน์: ฟังกลุ่ม คุย 1:1 สรุปทุกเช้า และซิงก์สมองกลางเข้า Claude",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "wrangler dev",
